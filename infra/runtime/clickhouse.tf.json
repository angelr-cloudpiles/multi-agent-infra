{
  "resource": {
    "aws_ecs_task_definition": {
      "clickhouse": {
        "family": "multi-agent-clickhouse",
        "network_mode": "awsvpc",
        "requires_compatibilities": ["FARGATE"],
        "cpu": "1024",
        "memory": "2048",
        "execution_role_arn": "${local.execution_role}",
        "runtime_platform": [{"cpu_architecture": "X86_64", "operating_system_family": "LINUX"}],
        "container_definitions": "[{\"name\": \"clickhouse\", \"image\": \"clickhouse/clickhouse-server:25.12\", \"cpu\": 0, \"portMappings\": [{\"containerPort\": 8123, \"hostPort\": 8123, \"protocol\": \"tcp\"}, {\"containerPort\": 9000, \"hostPort\": 9000, \"protocol\": \"tcp\"}], \"essential\": true, \"environment\": [{\"name\": \"CLICKHOUSE_USER\", \"value\": \"langfuse\"}, {\"name\": \"CLICKHOUSE_DB\", \"value\": \"default\"}, {\"name\": \"CLICKHOUSE_DEFAULT_ACCESS_MANAGEMENT\", \"value\": \"1\"}], \"mountPoints\": [{\"sourceVolume\": \"data\", \"containerPath\": \"/var/lib/clickhouse\"}], \"volumesFrom\": [], \"logConfiguration\": {\"logDriver\": \"awslogs\", \"options\": {\"awslogs-group\": \"/aws/ecs/multi-agent-platform\", \"awslogs-region\": \"us-east-1\", \"awslogs-stream-prefix\": \"clickhouse\"}}, \"systemControls\": [], \"secrets\": [{\"name\": \"CLICKHOUSE_PASSWORD\", \"valueFrom\": \"${local.clickhouse_secret_arn}:password::\"}]}]",
        "volume": [{"name": "data", "efs_volume_configuration": [{"file_system_id": "fs-0a919a9b5f4182fd5", "transit_encryption": "ENABLED", "authorization_config": [{"access_point_id": "fsap-0302f61865c9259a0", "iam": "DISABLED"}]}]}],
        "skip_destroy": true,
        "depends_on": ["aws_iam_role_policy.langfuse_secrets"]
      }
    },
    "aws_ecs_service": {
      "clickhouse": {
        "name": "multi-agent-clickhouse",
        "cluster": "${local.cluster}",
        "task_definition": "${aws_ecs_task_definition.clickhouse.arn}",
        "desired_count": 1,
        "launch_type": "FARGATE",
        "platform_version": "1.4.0",
        "deployment_minimum_healthy_percent": 0,
        "deployment_maximum_percent": 100,
        "network_configuration": [{"subnets": ["subnet-0aa9a8feadd153fa0", "subnet-08d4044dd3f658cee"], "security_groups": ["sg-0df86f02f93db38d4"], "assign_public_ip": false}],
        "service_registries": [{"registry_arn": "arn:aws:servicediscovery:us-east-1:278741241787:service/srv-224ie7gb2kv65whu"}],
        "deployment_circuit_breaker": [{"enable": true, "rollback": true}]
      }
    }
  }
}
